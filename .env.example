# ============================================================================
# ZLuxury Environment Configuration
# All configurable values - NO HARDCODING
# ============================================================================

# Application Settings
# --------------------
APP_NAME=ZLuxury
APP_ENV=development
APP_PORT=5200
APP_URL=http://localhost:5200

# API Configuration
# -----------------
API_BASE_URL=/api
API_TIMEOUT=30000
API_RETRY_COUNT=3

# Logging Configuration (Log4j-style)
# ------------------------------------
LOG_LEVEL=INFO
LOG_ENABLED=true
LOG_CONSOLE=true
LOG_FILE=false
LOG_MAX_ENTRIES=1000

# AI Agent Configuration
# ----------------------
AI_AGENT_ENABLED=true
AI_DEFAULT_AGENT=hermes
AI_RESPONSE_TIMEOUT=10000
AI_MAX_TOKENS=2000

# Hermes Agent Settings
HERMES_NAME=Hermes
HERMES_ROLE=Luxury Consultant
HERMES_COMMISSION_RATE=5

# OpenClaw Agent Settings
OPENCLAW_NAME=OpenClaw
OPENCLAW_ROLE=Market Intelligence
OPENCLAW_SUBSCRIPTION_RATE=100

# Unicorn Agent Settings (Hermes + OpenClaw merged)
UNICORN_NAME=Unicorn
UNICORN_ROLE=Unified Intelligence
UNICORN_PREMIUM_RATE=500

# VIP Membership Configuration
# ----------------------------
VIP_SYSTEM_ENABLED=true
VIP_POINTS_PER_CNY=1
VIP_SILVER_THRESHOLD=50000
VIP_GOLD_THRESHOLD=200000
VIP_BLACK_THRESHOLD=500000
VIP_DIAMOND_THRESHOLD=1000000

# VIP Discount Rates (%)
VIP_STANDARD_DISCOUNT=0
VIP_SILVER_DISCOUNT=3
VIP_GOLD_DISCOUNT=5
VIP_BLACK_DISCOUNT=8
VIP_DIAMOND_DISCOUNT=12

# Currency Configuration
# ----------------------
CURRENCY_DEFAULT=CNY
CURRENCY_USD_TO_CNY=7.2
CURRENCY_EUR_TO_CNY=7.8
CURRENCY_GBP_TO_CNY=9.0

# Product Configuration
# ---------------------
PRODUCT_PAGE_SIZE=20
PRODUCT_MAX_RESULTS=100
PRODUCT_IMAGE_QUALITY=high
PRODUCT_CACHE_DURATION=3600

# Cart Configuration
# ------------------
CART_SESSION_DURATION=86400
CART_MAX_ITEMS=50
CART_TAX_RATE=0

# Authentication Configuration
# ----------------------------
AUTH_SESSION_DURATION=604800
AUTH_TOKEN_EXPIRY=3600
AUTH_MAX_LOGIN_ATTEMPTS=5

# Security Configuration
# ----------------------
SECURITY_CORS_ORIGIN=*
SECURITY_RATE_LIMIT=100
SECURITY_RATE_WINDOW=60000

# Database Configuration (Future)
# -------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zluxury
DB_USER=zluxury_user
# DB_PASSWORD= (set in production)

# External Services (Future)
# --------------------------
EXTERNAL_AUCTION_API_URL=
EXTERNAL_PAYMENT_GATEWAY=
EXTERNAL_SHIPPING_API=

# GitHub Configuration
# --------------------
GITHUB_USER=vcfhuang@qq.com
GITHUB_REPO=zluxury
GITHUB_BRANCH=main

# Version Information
# -------------------
APP_VERSION=1.2.0
APP_VERSION_FORMAT=V.MAJOR.MINOR.PATCH