{
  "name": "zluxury",
  "version": "1.0.0",
  "description": "Professional Online Luxury Commerce Platform - AI-Powered Auction & Marketplace System",
  "main": "index.js",
  "scripts": {
    "dev": "next dev -p 5200",
    "build": "next build",
    "start": "next start -p 5200",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "backup": "node scripts/backup.js",
    "version:bump": "node scripts/version-bump.js",
    "version:major": "node scripts/version-bump.js major",
    "version:minor": "node scripts/version-bump.js minor",
    "version:patch": "node scripts/version-bump.js patch",
    "git:push": "node scripts/git-push.js",
    "git:setup": "node scripts/git-push.js setup",
    "git:feature": "node scripts/git-push.js feature",
    "git:init": "git init && git add . && git commit -m \"Initial commit - ZLuxury v1.0.0\"",
    "deploy": "npm run build && npm run start"
  },
  "keywords": ["luxury", "auction", "ai", "ecommerce", "premium", "hermes", "openclaw", "unicorn", "sothebys", "christies"],
  "author": "ZLuxury Team",
  "license": "MIT",
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0",
    "axios": "^1.6.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "react-icons": "^5.0.0",
    "framer-motion": "^11.0.0",
    "recharts": "^2.12.0",
    "date-fns": "^3.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.2.0"
  }
}