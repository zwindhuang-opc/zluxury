# ============================================================================
# ZLuxury Environment Configuration
# ============================================================================
# 
# Copy this file to .env.local for local development
# NEVER commit .env.local to version control!
#
# Usage:
#   cp .env.example .env.local
#   # Edit .env.local with your actual values
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION SETTINGS / 应用设置
# ----------------------------------------------------------------------------

# Node environment (development, production, staging)
NODE_ENV=development

# Application port (avoid 3XXX, 8XXX, 42001; use 19000 for current server)
PORT=19000

# Application URL (used for generating links)
NEXT_PUBLIC_APP_URL=http://localhost:19000

# Application name
NEXT_PUBLIC_APP_NAME=ZLuxury

# Application version (auto-updated by version.js)
NEXT_PUBLIC_APP_VERSION=2.0.0

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION / 数据库配置
# ----------------------------------------------------------------------------

# PostgreSQL connection string (for production)
DATABASE_URL=postgresql://user:password@localhost:5432/zluxury

# Redis connection (for cache/sessions)
REDIS_URL=redis://localhost:6379

# Use mock data instead of real database (for development)
USE_MOCK_DATA=true

# ----------------------------------------------------------------------------
# AUTHENTICATION / 认证配置
# ----------------------------------------------------------------------------

# JWT Secret Key (generate with: openssl rand -base64 32)
JWT_SECRET=zluxury-dev-secret-key-change-in-production-2025

# JWT Expiration time
JWT_EXPIRES_IN=7d

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Admin default credentials (for initial setup)
ADMIN_EMAIL=admin@zluxury.com
ADMIN_PASSWORD=admin123456

# ----------------------------------------------------------------------------
# PAYMENT GATEWAYS / 支付网关
# ----------------------------------------------------------------------------

# Stripe (for international payments)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Alipay (for China domestic payments)
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# WeChat Pay (for China domestic payments)
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=

# Currency configuration
DEFAULT_CURRENCY=CNY
SUPPORTED_CURRENCIES=USD,CNY,EUR,GBP,JPY,HKD

# ----------------------------------------------------------------------------
# EXCHANGE RATE API / 汇率API
# ----------------------------------------------------------------------------

# Exchange rate provider (fixer, openexchange, or mock)
EXCHANGE_RATE_PROVIDER=mock

# API key for exchange rate service
EXCHANGE_RATE_API_KEY=

# Cache duration for exchange rates (in minutes)
EXCHANGE_RATE_CACHE_MINUTES=60

# Default fallback exchange rate (USD to CNY)
FALLBACK_EXCHANGE_RATE_USD_CNY=7.24

# ----------------------------------------------------------------------------
# SHIPPING & LOGISTICS / 物流配送
# ----------------------------------------------------------------------------

# DHL API credentials
DHL_API_KEY=
DHL_API_SECRET=

# FedEx API credentials
FEDEX_API_KEY=
FEDEX_API_SECRET=
FEDEX_ACCOUNT_NUMBER=

# SF Express (顺丰速运) for China domestic
SF_EXPRESS_API_KEY=
SF_EXPRESS_CUSTOMER_CODE=

# Free shipping threshold (CNY)
FREE_SHIPPING_THRESHOLD=1000

# Default warehouse location
DEFAULT_WAREHOUSE=SHANGHAI_FTZ

# ----------------------------------------------------------------------------
# AI SERVICES / AI服务
# ----------------------------------------------------------------------------

# OpenAI API (for AI assistant)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Alternative: Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# AI response settings
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# Enable/disable AI features
ENABLE_AI_ASSISTANT=true
ENABLE_AI_RECOMMENDATIONS=true

# ----------------------------------------------------------------------------
# EMAIL SERVICE / 邮件服务
# ----------------------------------------------------------------------------

# SendGrid (recommended)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@zluxury.com
SENDGRID_FROM_NAME=ZLuxury

# SMTP alternative (for self-hosted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ----------------------------------------------------------------------------
# FILE STORAGE / 文件存储
# ----------------------------------------------------------------------------

# AWS S3 (for product images)
AWS_S3_BUCKET=zluxury-product-images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-east-1

# Local storage path (for development)
LOCAL_UPLOAD_PATH=./public/uploads/products

# Maximum upload size (in bytes)
MAX_UPLOAD_SIZE=10485760  # 10MB

# Allowed image types
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ----------------------------------------------------------------------------
# ANALYTICS & MONITORING / 分析与监控
# ----------------------------------------------------------------------------

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry (error tracking)
SENTRY_DSN=

# DataDog (APM monitoring)
DATADOG_API_KEY=

# Log level (error, warn, info, debug, trace)
LOG_LEVEL=debug

# Log directory
LOG_DIR=./logs

# ----------------------------------------------------------------------------
# FEATURE FLAGS / 功能开关
# ----------------------------------------------------------------------------

# Toggle features on/off without redeploying
ENABLE_USER_AUTHENTICATION=true
ENABLE_SHOPPING_CART=true
ENABLE_CHECKOUT=true
ENABLE_ORDER_MANAGEMENT=true
ENABLE_ADMIN_DASHBOARD=false
ENABLE_PRODUCT_REVIEWS=true
ENABLE_WISHLIST=true
ENABLE_PRODUCT_COMPARISON=true
ENABLE_LIVE_CHAT=true
ENABLE_MULTI_LANGUAGE=true
ENABLE_CURRENCY_SWITCHER=true
ENABLE_NEWSLETTER=true

# ----------------------------------------------------------------------------
# CROSS-BORDER BUSINESS / 跨境业务配置
# ----------------------------------------------------------------------------

# Hong Kong business registration
HK_COMPANY_NAME=
HK_BR_NUMBER=

# Shanghai residency details
SHANGHAI_RESIDENCY_PERMIT_NUMBER=

# Customs broker information
CUSTOMS_BROKER_NAME=
CUSTOMS_BROKER_CONTACT=

# Bonded warehouse location
BONDED_WAREHOUSE_ADDRESS=Shanghai Free Trade Zone, Pudong, Shanghai

# Import duty rates (override defaults)
DEFAULT_IMPORT_DUTY_RATE=0.20
DEFAULT_VAT_RATE=0.13
DEFAULT_CONSUMPTION_TAX_RATE=0.10

# Personal carry allowance (per person per year)
PERSONAL_CARRY_ALLOWANCE_CNY=50000

# ----------------------------------------------------------------------------
# CACHE CONFIGURATION / 缓存配置
# ----------------------------------------------------------------------------

# Redis TTL (time-to-live) in seconds
CACHE_TTL_DEFAULT=3600        # 1 hour
CACHE_TTL_PRODUCTS=1800       # 30 minutes
CACHE_TTL_PRICING=300         # 5 minutes
CACHE_TTL_EXCHANGE_RATES=3600 # 1 hour

# Enable CDN
ENABLE_CDN=false
CDN_URL=https://cdn.zluxury.com

# ----------------------------------------------------------------------------
# SECURITY / 安全设置
# ----------------------------------------------------------------------------

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:13153,https://zluxury.com

# Rate limiting (requests per minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Session settings
SESSION_SECRET=session-secret-change-in-production
SESSION_MAX_AGE=86400000  # 24 hours

# CSRF protection
CSRF_SECRET=csrf-secret-change-in-production

# ----------------------------------------------------------------------------
# DEVELOPMENT SETTINGS / 开发设置
# ----------------------------------------------------------------------------

# Enable hot reload
NEXT_DEV_HMR=true

# Show dev tools overlay
NEXT_DEV_OVERLAY=true

# Debug mode (verbose logging)
DEBUG_MODE=true

# Mock external APIs (for offline development)
MOCK_EXTERNAL_APIS=true

# ----------------------------------------------------------------------------
# END OF CONFIGURATION / 配置结束
# ============================================================================
